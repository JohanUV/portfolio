---
interface Props {
  id: string;
  num: string;
  eyebrow: string;
  title: string;
  body?: string;
  divider?: boolean;
}

const { id, num, eyebrow, title, body, divider = true } = Astro.props;
---

<section id={id} class={`${divider ? 'hairline' : ''} scroll-mt-24`}>
  <div class="shell py-20 md:py-28">
    <div class="flex items-baseline gap-4">
      <span class="section-num">{num}</span>
      <p class="eyebrow">{eyebrow}</p>
    </div>

    <h2 class="display mt-6 max-w-4xl text-[length:var(--text-h2)]">
      {title}
    </h2>

    {body && <p class="mt-6 max-w-2xl leading-relaxed text-ink-muted">{body}</p>}

    <div class="mt-14">
      <slot />
    </div>
  </div>
</section>
