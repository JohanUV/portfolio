---
import { site } from '../data/site';
import { getLangFromUrl, useTranslations, localizePath, alternatePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath(lang, '/');

const links = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#stack`, label: t('nav.stack') },
  { href: `${home}#security`, label: t('nav.security') },
  { href: `${home}#about`, label: t('nav.about') },
];

const other = lang === 'en' ? 'es' : 'en';
const otherHref = alternatePath(Astro.url, other);
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-surface/80 backdrop-blur-xl supports-[backdrop-filter]:bg-surface/65"
>
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a
      href={home}
      class="group flex items-center gap-2.5 font-mono text-sm tracking-tight"
      aria-label={site.name}
    >
      <span
        class="grid size-8 place-items-center rounded-md border border-line-strong bg-surface-raised text-[0.7rem] font-semibold text-accent transition-colors group-hover:border-accent/50"
      >
        {site.initials}
      </span>
      <span class="hidden text-ink sm:inline">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm text-ink-muted transition-colors hover:text-ink"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={otherHref}
        hreflang={other}
        class="rounded-md border border-line px-2.5 py-1 font-mono text-[0.7rem] tracking-widest text-ink-muted transition-colors hover:border-line-strong hover:text-ink"
        aria-label={other === 'es' ? 'Ver en español' : 'View in English'}
      >
        {other.toUpperCase()}
      </a>

      <a
        href={`${home}#contact`}
        class="rounded-md border border-accent/35 bg-accent/10 px-3 py-1.5 text-sm font-medium text-accent transition-colors hover:bg-accent/18"
      >
        {t('nav.contact')}
      </a>
    </div>
  </div>
</header>
