---
import { site } from '../data/site';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath(lang, '/');

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

const techline = t('hero.techline').split(' · ');
---

<section class="relative overflow-hidden">
  <div class="hero-wash absolute inset-0 -z-20" aria-hidden="true"></div>
  <div class="grid-lines absolute inset-0 -z-10 opacity-45" aria-hidden="true"></div>

  <div class="shell pt-14 pb-20 md:pt-20 md:pb-28">
    <!-- Encuadre original: texto a la izquierda, foto a la derecha con la
         disponibilidad y ubicación justo debajo de ella. -->
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
      <div class="min-w-0">
        <p class="eyebrow">{t('hero.role')}</p>

        <h1 class="display mt-6 text-[length:var(--text-display)]">
          <span class="block text-ink-muted">{firstName}</span>
          <span class="block text-ink">{lastName}</span>
        </h1>

        <p class="mt-8 max-w-2xl text-[length:var(--text-lead)] leading-snug text-ink">
          {t('hero.tagline')}
        </p>

        <p class="mt-5 max-w-xl leading-relaxed text-ink-muted">
          {t('hero.body')}
        </p>

        <ul class="mt-8 flex flex-wrap gap-2">
          {techline.map((tech) => <li class="tag">{tech}</li>)}
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href={`${home}#work`}
            class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-surface transition-colors hover:bg-accent-deep"
          >
            {t('hero.cta.work')}
          </a>
          <a
            href={`${home}#contact`}
            class="rounded-lg border border-line-strong px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent/50 hover:text-accent"
          >
            {t('hero.cta.contact')}
          </a>
        </div>

        <!-- Descarga del CV, con los dos idiomas explícitos. -->
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="font-mono text-[0.7rem] tracking-widest text-ink-dim uppercase">
            {t('hero.cv')}
          </span>
          <a
            href={site.resume.en}
            download
            class="rounded-md border border-line px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/50 hover:text-accent"
          >
            English ↓
          </a>
          <a
            href={site.resume.es}
            download
            class="rounded-md border border-line px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent/50 hover:text-accent"
          >
            Español ↓
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[0.7rem] tracking-widest uppercase">
          <li><a href={site.github} rel="noopener" class="text-ink-muted transition-colors hover:text-accent">GitHub</a></li>
          <li><a href={site.linkedin} rel="noopener" class="text-ink-muted transition-colors hover:text-accent">LinkedIn</a></li>
          <li><a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="text-ink-muted transition-colors hover:text-accent">WhatsApp</a></li>
          <li><a href={`mailto:${site.email}`} class="text-ink-muted transition-colors hover:text-accent">Email</a></li>
        </ul>
      </div>

      {
        site.portrait && (
          <div class="order-first mx-auto w-full max-w-64 lg:order-none lg:mx-0 lg:max-w-none">
            <div class="group relative">
              <div
                class="absolute -inset-2.5 -z-10 rounded-2xl border border-line transition-colors duration-500 group-hover:border-accent/30"
                aria-hidden="true"
              />
              <img
                src={site.portrait}
                alt={site.name}
                width="760"
                height="1013"
                fetchpriority="high"
                decoding="async"
                class="aspect-[3/4] w-full rounded-xl border border-line-strong object-cover grayscale contrast-105 transition-all duration-500 group-hover:grayscale-0 group-hover:contrast-100"
              />
            </div>

            <p class="mt-6 flex items-start gap-2.5 font-mono text-[0.7rem] leading-relaxed text-ink-muted">
              <span class="relative mt-1.5 flex size-1.5 shrink-0">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-70" />
                <span class="relative inline-flex size-1.5 rounded-full bg-accent" />
              </span>
              <span>{t('hero.available')}</span>
            </p>
            <p class="mt-2 font-mono text-[0.7rem] text-ink-dim">
              {site.location[lang]} · {site.timezone}
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
