---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useTranslations(lang);
const c = project[lang];
const href = localizePath(lang, `/work/${project.slug}`);
const num = String(index + 1).padStart(2, '0');
const cover = project.shots?.[0];
---

<article class="card group p-6 md:p-8">
  <div class:list={['grid gap-8', cover ? 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]' : 'lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]']}>
    <div class="min-w-0">
      <div class="flex items-center gap-3 font-mono text-xs text-ink-dim">
        <span class="text-accent">{num}</span>
        <span class="h-px w-6 bg-line-strong"></span>
        <span>{project.year}</span>
      </div>

      <h3 class="display-sm mt-4 text-3xl md:text-4xl">
        <a href={href} class="after:absolute after:inset-0 after:content-['']">
          {c.title}
        </a>
      </h3>

      <p class="mt-1.5 text-sm text-ink-dim">{c.kind}</p>

      <p class="mt-5 max-w-2xl leading-relaxed text-ink">{c.tagline}</p>

      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-muted">{c.summary}</p>

      <ul class="mt-6 flex flex-wrap gap-1.5">
        {project.accentTags.map((tag) => <li class="tag tag-accent">{tag}</li>)}
        {project.stack.slice(0, 5).map((tech) => <li class="tag">{tech}</li>)}
      </ul>

      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <span class="relative z-10 font-medium text-accent transition-transform group-hover:translate-x-0.5">
          {t('work.readCase')} <span aria-hidden="true">→</span>
        </span>
        {
          project.repo && (
            <a
              href={project.repo}
              rel="noopener"
              class="relative z-10 text-ink-muted transition-colors hover:text-ink"
            >
              {t('work.viewCode')}
            </a>
          )
        }
        {
          project.demo && (
            <a
              href={project.demo}
              rel="noopener"
              class="relative z-10 text-ink-muted transition-colors hover:text-ink"
            >
              {t('work.liveDemo')}
            </a>
          )
        }
      </div>
    </div>

    {
      cover ? (
        <div class="relative min-h-64 overflow-hidden rounded-lg border border-line bg-surface lg:min-h-0">
          <img
            src={cover.src}
            alt={cover[lang].alt}
            width={cover.width}
            height={cover.height}
            loading="lazy"
            decoding="async"
            class="aspect-[16/10] w-full object-cover object-left-top transition-transform duration-500 group-hover:scale-[1.015] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
          />
        </div>
      ) : (
        <dl
          class="metrics-side grid gap-px self-start overflow-hidden rounded-lg border border-line bg-line"
          style={`--cols:${c.metrics.length}`}
        >
          {c.metrics.map((m) => (
            <div class="bg-surface px-5 py-5">
              <dt class="display-sm text-3xl text-accent tabular-nums">{m.value}</dt>
              <dd class="mt-1.5 text-xs leading-snug text-ink-dim">{m.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      cover && (
        <dl
          class="grid gap-px overflow-hidden rounded-lg border border-line bg-line lg:col-span-2"
          style={`grid-template-columns: repeat(${c.metrics.length}, minmax(0, 1fr))`}
        >
          {c.metrics.map((m) => (
            <div class="bg-surface px-4 py-4">
              <dt class="display-sm text-2xl text-accent tabular-nums">{m.value}</dt>
              <dd class="mt-1.5 text-xs leading-snug text-ink-dim">{m.label}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</article>
