---
import { site } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Section from './Section.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const channels = [
  { label: 'WhatsApp', value: site.whatsappDisplay, href: `https://wa.me/${site.whatsapp}` },
  { label: 'LinkedIn', value: site.name, href: site.linkedin },
  { label: 'GitHub', value: '@JohanUV', href: site.github },
  { label: lang === 'es' ? 'CV (PDF)' : 'Résumé (PDF)', value: lang === 'es' ? 'Español' : 'English', href: site.resume[lang] },
];
---

<Section id="contact" num="05" eyebrow={t('contact.eyebrow')} title={t('contact.title')}>
  <p class="-mt-8 max-w-xl leading-relaxed text-ink-muted">{t('contact.body')}</p>

  <a
    href={`mailto:${site.email}`}
    class="group mt-10 inline-flex flex-wrap items-baseline gap-x-4 gap-y-1"
  >
    <span
      class="display-sm text-2xl break-all text-ink transition-colors group-hover:text-accent md:text-4xl"
    >
      {site.email}
    </span>
    <span
      class="font-mono text-xs text-accent transition-transform group-hover:translate-x-1"
      aria-hidden="true">→</span
    >
  </a>

  <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      channels.map((ch) => (
        <a
          href={ch.href}
          rel="noopener"
          class="group bg-surface-raised px-5 py-5 transition-colors hover:bg-surface-hover"
        >
          <p class="font-mono text-[0.7rem] tracking-[0.15em] text-ink-dim uppercase">{ch.label}</p>
          <p class="mt-2 truncate text-sm text-ink transition-colors group-hover:text-accent">
            {ch.value}
          </p>
        </a>
      ))
    }
  </div>
</Section>
