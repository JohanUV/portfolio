---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';

interface Props {
  project: Project;
  next: Project;
  lang: Lang;
}

const { project, next, lang } = Astro.props;
const t = useTranslations(lang);
const c = project[lang];
const nextC = next[lang];
const shots = project.shots ?? [];
---

<article>
  <header class="relative overflow-hidden">
    <div class="hero-wash absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="shell pt-14 pb-16 md:pt-20 md:pb-20">
      <a
        href={`${localizePath(lang, '/')}#work`}
        class="font-mono text-xs text-ink-muted transition-colors hover:text-accent"
      >
        <span aria-hidden="true">←</span> {t('case.back')}
      </a>

      <div class="mt-8 flex flex-wrap items-center gap-2">
        {project.accentTags.map((tag) => <span class="tag tag-accent">{tag}</span>)}
        <span class="tag">{project.year}</span>
      </div>

      <h1 class="display mt-6 max-w-4xl text-5xl md:text-7xl">
        {c.title}
      </h1>
      <p class="mt-3 text-sm text-ink-dim">{c.kind}</p>

      <p class="mt-8 max-w-3xl text-xl leading-snug text-ink-muted md:text-2xl">
        {c.tagline}
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        {
          project.repo && (
            <a
              href={project.repo}
              rel="noopener"
              class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-accent/50 hover:text-accent"
            >
              {t('work.viewCode')}
            </a>
          )
        }
        {
          project.demo && (
            <a
              href={project.demo}
              rel="noopener"
              class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-surface transition-colors hover:bg-accent-deep"
            >
              {t('work.liveDemo')}
            </a>
          )
        }
        {
          project.doc && (
            <a
              href={project.doc.url}
              target="_blank"
              rel="noopener"
              class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-accent/50 hover:text-accent"
            >
              {project.doc.label[lang]} <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>

      <dl
        class="mt-12 grid max-w-2xl gap-px overflow-hidden rounded-xl border border-line bg-line"
        style={`grid-template-columns: repeat(${c.metrics.length}, minmax(0, 1fr))`}
      >
        {
          c.metrics.map((m) => (
            <div class="bg-surface-raised px-5 py-5">
              <dt class="font-mono text-2xl font-semibold text-accent tabular-nums">{m.value}</dt>
              <dd class="mt-1.5 text-xs leading-snug text-ink-dim">{m.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  {
    shots.length > 0 && (
      <section class="shell hairline pt-16">
        <h2 class="font-mono text-[0.7rem] tracking-[0.18em] text-accent uppercase">
          {t('case.evidence')}
        </h2>

        {/* Una sola portada por proyecto. Lo demás se ve en vivo, abajo. */}
        <figure class="mt-8">
          <div class="overflow-hidden rounded-xl border border-line bg-surface">
            <img
              src={shots[0].src}
              alt={shots[0][lang].alt}
              width={shots[0].width}
              height={shots[0].height}
              loading="lazy"
              decoding="async"
              class="w-full"
            />
          </div>
          <figcaption class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-ink-dim">
            {shots[0][lang].caption}
          </figcaption>
        </figure>

        {
          shots.length > 1 && (
            <div class="more-evidence mt-8">
              <button
                type="button"
                data-toggle
                aria-expanded="false"
                class="inline-flex items-center gap-2 rounded-lg border border-line-strong px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-accent/50 hover:text-accent"
              >
                <span data-chevron aria-hidden="true" class="inline-block transition-transform">▾</span>
                <span data-label-expand>{project.moreEvidenceLabel?.[lang] ?? t('case.more.expand')}</span>
                <span data-label-collapse hidden>{t('case.more.collapse')}</span>
              </button>

              <div data-panel hidden class="mt-6 flex flex-col gap-12">
                {shots.slice(1).map((shot) => (
                  <figure>
                    <div class="overflow-hidden rounded-xl border border-line bg-surface">
                      <img
                        src={shot.src}
                        alt={shot[lang].alt}
                        width={shot.width}
                        height={shot.height}
                        loading="lazy"
                        decoding="async"
                        class="w-full"
                      />
                    </div>
                    <figcaption class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-ink-dim">
                      {shot[lang].caption}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )
        }

        {
          project.demo && (
            <div class="live-embed mt-8" data-src={project.demo}>
              <div class="flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  data-toggle
                  aria-expanded="false"
                  class="inline-flex items-center gap-2 rounded-lg border border-line-strong px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-accent/50 hover:text-accent"
                >
                  <span data-chevron aria-hidden="true" class="inline-block transition-transform">▾</span>
                  <span data-label-expand>{t('case.live.expand')}</span>
                  <span data-label-collapse hidden>{t('case.live.collapse')}</span>
                </button>
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-accent"
                >
                  {t('case.live.open')} <span aria-hidden="true">↗</span>
                </a>
              </div>

              <div data-frame hidden class="mt-4">
                <div class="overflow-hidden rounded-xl border border-line-strong bg-surface-raised">
                  {/* Barra tipo navegador: sitúa al visitante y muestra la URL real. */}
                  <div class="flex items-center gap-3 border-b border-line px-4 py-2.5">
                    <span class="flex gap-1.5" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-line-strong" />
                      <span class="size-2.5 rounded-full bg-line-strong" />
                      <span class="size-2.5 rounded-full bg-line-strong" />
                    </span>
                    <span class="truncate font-mono text-xs text-ink-dim">{project.demo}</span>
                  </div>
                  <iframe
                    title={c.title}
                    data-iframe
                    class="block h-[70vh] min-h-[480px] w-full bg-white"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  />
                </div>
                <p class="mt-3 text-xs leading-relaxed text-ink-dim">{t('case.live.note')}</p>
              </div>
            </div>
          )
        }
      </section>
    )
  }

  <div class="shell hairline pt-16 pb-8">
    <div class="mx-auto max-w-2xl">
      <div>
        <section>
          <h2 class="font-mono text-[0.7rem] tracking-[0.18em] text-accent uppercase">
            {t('case.context')}
          </h2>
          <p class="mt-4 leading-relaxed text-ink-muted">{c.context}</p>
        </section>

        <section class="mt-14">
          <h2 class="font-mono text-[0.7rem] tracking-[0.18em] text-accent uppercase">
            {t('case.problem')}
          </h2>
          <p class="mt-4 leading-relaxed text-ink">{c.problem}</p>
        </section>

        <section class="mt-14">
          <h2 class="font-mono text-[0.7rem] tracking-[0.18em] text-accent uppercase">
            {t('case.decisions')}
          </h2>
          <ol class="mt-6 flex flex-col gap-8">
            {
              c.decisions.map((d, i) => (
                <li class="border-l border-line pl-6">
                  <span class="font-mono text-xs text-ink-dim">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="mt-2 text-lg font-semibold tracking-tight">{d.title}</h3>
                  <p class="mt-2.5 leading-relaxed text-ink-muted">{d.body}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="mt-14">
          <h2 class="font-mono text-[0.7rem] tracking-[0.18em] text-accent uppercase">
            {t('case.outcome')}
          </h2>
          <ul class="mt-5 flex flex-col gap-3">
            {
              c.outcome.map((item) => (
                <li class="flex gap-3 leading-relaxed text-ink-muted">
                  <span class="mt-2.5 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <div class="mt-14 rounded-xl border border-line bg-surface-raised p-6">
        <h2 class="font-mono text-[0.7rem] tracking-[0.18em] text-ink-dim uppercase">
          {t('case.stack')}
        </h2>
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {project.stack.map((tech) => <li class="tag">{tech}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <div class="shell pb-4">
    <a
      href={localizePath(lang, `/work/${next.slug}`)}
      class="card group mt-16 flex items-center justify-between gap-6 p-6 md:p-8"
    >
      <div>
        <p class="font-mono text-[0.7rem] tracking-[0.18em] text-ink-dim uppercase">
          {t('case.next')}
        </p>
        <p class="mt-2 text-xl font-semibold tracking-tight md:text-2xl">{nextC.title}</p>
        <p class="mt-1 text-sm text-ink-dim">{nextC.kind}</p>
      </div>
      <span
        class="shrink-0 text-2xl text-accent transition-transform group-hover:translate-x-1"
        aria-hidden="true">→</span
      >
    </a>
  </div>
</article>

<script>
  // El iframe solo carga la web cuando alguien despliega la vista: no
  // penaliza la carga de la página a quien no la abre.
  document.querySelectorAll<HTMLElement>('.more-evidence').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const chevron = root.querySelector<HTMLElement>('[data-chevron]')!;
    const lblExpand = root.querySelector<HTMLElement>('[data-label-expand]')!;
    const lblCollapse = root.querySelector<HTMLElement>('[data-label-collapse]')!;
    btn.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      chevron.style.transform = open ? 'rotate(180deg)' : '';
      lblExpand.hidden = open;
      lblCollapse.hidden = !open;
    });
  });

  document.querySelectorAll<HTMLElement>('.live-embed').forEach((root) => {
    const src = root.dataset.src!;
    const btn = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const iframe = root.querySelector<HTMLIFrameElement>('[data-iframe]')!;
    const chevron = root.querySelector<HTMLElement>('[data-chevron]')!;
    const lblExpand = root.querySelector<HTMLElement>('[data-label-expand]')!;
    const lblCollapse = root.querySelector<HTMLElement>('[data-label-collapse]')!;

    btn.addEventListener('click', () => {
      const open = frame.hidden;
      if (open && !iframe.src) iframe.src = src;
      frame.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      chevron.style.transform = open ? 'rotate(180deg)' : '';
      lblExpand.hidden = open;
      lblCollapse.hidden = !open;
      if (open) frame.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
