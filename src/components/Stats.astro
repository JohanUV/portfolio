---
import { heroStats } from '../data/site';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<div class="hairline">
  <div class="shell py-14">
    <dl class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      {
        heroStats.map((stat) => (
          <div class="flex flex-col">
            <dt class="display-sm text-5xl text-accent tabular-nums md:text-6xl">{stat.value}</dt>
            <dd class="mt-3 max-w-56 text-sm leading-snug text-ink-muted">{stat.label[lang]}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
