---
import { heroStats } from '../data/site';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<dl class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3">
  {
    heroStats.map((stat) => (
      <div class="bg-surface-raised px-5 py-6">
        <dt class="display-sm text-4xl text-accent tabular-nums">{stat.value}</dt>
        <dd class="mt-2.5 text-sm leading-snug text-ink-muted">{stat.label[lang]}</dd>
      </div>
    ))
  }
</dl>
