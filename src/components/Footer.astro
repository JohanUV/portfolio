---
import { site } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = 2026;
---

<footer class="hairline mt-28">
  <div
    class="shell flex flex-col gap-4 py-10 text-sm text-ink-dim sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {site.name}. {t('footer.rights')}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href={site.github} class="transition-colors hover:text-ink" rel="me noopener">GitHub</a>
      <a href={site.linkedin} class="transition-colors hover:text-ink" rel="me noopener">LinkedIn</a>
      <a href={`https://wa.me/${site.whatsapp}`} class="transition-colors hover:text-ink" rel="noopener">WhatsApp</a>
      <a href={`mailto:${site.email}`} class="transition-colors hover:text-ink">Email</a>
    </div>
  </div>
</footer>
