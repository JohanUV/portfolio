---
import Base from '../../layouts/Base.astro';
import HomeSections from '../../components/HomeSections.astro';
import { site } from '../../data/site';

const title = `${site.name} — Ingeniero de Software`;
const description =
  'Ingeniero de software en Latacunga, Ecuador. Construyo pipelines de datos, integraciones de APIs y sistemas con IA aplicada — nueve fuentes estatales integradas, tres APIs no documentadas analizadas por ingeniería inversa. En transición hacia seguridad ofensiva.';
---

<Base title={title} description={description} >
  <HomeSections />
</Base>
